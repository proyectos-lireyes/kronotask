rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /user_data/{docId} {
      allow read, write: if true;

      match /tasks/{taskId} {
        allow read, write: if true;
      }

      match /meta/{metaId} {
        allow read, write: if true;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
